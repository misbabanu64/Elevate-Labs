pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building application for Task-02...'
                bat 'dir Task-02'
            }
        }

        stage('Test') {
            steps {
                echo 'Running automated tests...'
                bat 'findstr "Elevate Labs" Task-02\\index.html'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying Task-02 web application...'
                bat 'if not exist deploy mkdir deploy && copy /Y Task-02\\index.html deploy\\index.html'
            }
        }
    }
}
